<%# ICODOS landing page — shown at / for unauthenticated visitors. %>
<%# The shared navbar is hidden on unauth pages (see shared/_navbar.html.erb %>
<%# overlay), so the centered ICODOS logo is the only brand on the page. %>
<%= content_for(:canonical_url, root_url) %>
<section class="flex items-center justify-center min-h-[75vh]">
  <div class="max-w-md mx-auto px-4 text-center">
    <img src="/icodos-logo.png" alt="ICODOS" style="height: 5rem; width: auto;" class="mx-auto">

    <p class="text-lg text-gray-600 mt-8 mb-8">
      Internal document signing for ICODOS staff.
    </p>

    <a href="/auth/entra" class="base-button block text-lg">
      Sign in with Microsoft
    </a>

    <p class="mt-8 text-sm text-gray-500">
      External signers: check your email for a personal signing link.
    </p>
  </div>
</section>

<p class="text-center text-xs text-gray-400 pb-6">
  <a href="<%= new_user_session_path %>" class="link">Password sign-in</a>
  <span class="mx-2">·</span>
  Powered by <a href="https://github.com/docusealco/docuseal" target="_blank" rel="noopener" class="link">DocuSeal</a>
</p>
