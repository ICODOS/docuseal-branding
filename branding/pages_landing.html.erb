<%# ICODOS override of app/views/pages/landing.html.erb %>
<%#
  Shown at / to unauthenticated visitors. The shared navbar is hidden on
  unauthenticated pages (see shared__navbar.html.erb), so the centred ICODOS
  logo is the only brand on the page.

  /auth/entra is written out as a literal rather than sso_entra_start_path on
  purpose: the documented rollback for the SSO layer is to delete its mount
  block from docker-compose.yml, which also removes the route helper. A literal
  path then 404s; the helper would raise and take the whole landing page down.

  ONLY USE CLASSES DOCUSEAL ALREADY USES. The CSS in /app/public/packs is
  precompiled from upstream's own sources and Tailwind purged the rest, so an
  unused class silently does nothing. pt-20, pb-8 and leading-relaxed are
  absent, which is why the page spacing is set inline. Verify before using:
    grep -F 'the-class' /app/public/packs/css/application-*.css

  CHECK THIS FILE ON EVERY DOCUSEAL VERSION BUMP.
%>
<%= content_for(:canonical_url, root_url) %>

<%
  # When SSO_ENFORCE blocks password login, /sign_in only bounces back to
  # Microsoft, so the link below would be a dead end. defined?(Sso) keeps this
  # page working if the SSO mount block is ever removed.
  password_sign_in_available = !defined?(Sso) || Sso.password_login_allowed?
%>

<div class="max-w-md mx-auto px-4 text-center" style="padding-top: 5rem; padding-bottom: 2rem;">
  <img src="/icodos-logo.png" alt="ICODOS" width="732" height="255" decoding="async" class="mx-auto" style="height: 5rem; width: auto; object-fit: contain;">

  <h1 class="text-2xl" style="margin-top: 2rem; font-weight: 600;">
    Document signing for ICODOS
  </h1>
  <p class="text-gray-500 mt-2">
    Internal use only. Staff sign in with Microsoft.
  </p>

  <a href="/auth/entra" class="base-button w-full" style="margin-top: 2.5rem;">
    Sign in with Microsoft
  </a>

  <p class="text-sm text-gray-500 mt-8" style="line-height: 1.6;">
    Have a document to sign?<br>
    Check your email for a personal signing link;
    you do not need to sign in on this page.
  </p>
</div>

<p class="text-center text-xs text-gray-400" style="margin-top: 3rem; padding-bottom: 1.5rem;">
  <% if password_sign_in_available %>
    <a href="<%= new_user_session_path %>" class="link">Password sign-in</a>
    <span class="mx-2" aria-hidden="true">·</span>
  <% end %>
  Powered by
  <a href="https://github.com/docusealco/docuseal" target="_blank" rel="noopener" class="link">DocuSeal</a>
</p>
