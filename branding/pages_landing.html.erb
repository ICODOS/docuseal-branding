<%# ICODOS landing page — shown at / for unauthenticated visitors. %>
<%# The shared navbar is hidden on unauth pages (see shared/_navbar.html.erb %>
<%# overlay), so the centered ICODOS logo is the only brand on the page. %>
<%= content_for(:canonical_url, root_url) %>
<div class="max-w-md mx-auto px-4 text-center pt-24 pb-16">
  <img src="/icodos-logo.png" alt="ICODOS" style="height: 4.5rem; width: auto;" class="mx-auto">

  <h1 class="text-2xl font-semibold mt-10">
    Document signing for ICODOS
  </h1>
  <p class="text-base text-gray-500 mt-2">
    Internal use only — staff sign in with Microsoft.
  </p>

  <a href="/auth/entra" class="base-button block text-lg mt-10">
    Sign in with Microsoft
  </a>

  <p class="mt-8 text-sm text-gray-500 leading-relaxed">
    Have a document to sign? Check your email for a personal signing link —
    you don't need to sign in on this page.
  </p>
</div>

<p class="text-center text-xs text-gray-400 mt-16 pb-6">
  <a href="<%= new_user_session_path %>" class="link">Password sign-in</a>
  <span class="mx-2">·</span>
  Powered by <a href="https://github.com/docusealco/docuseal" target="_blank" rel="noopener" class="link">DocuSeal</a>
</p>
