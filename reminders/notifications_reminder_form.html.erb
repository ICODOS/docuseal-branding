<%# ICODOS override of notifications_settings/_reminder_form.html.erb
    Upstream is three dropdowns writing `submitter_reminders`, a key nothing in
    the community build reads.

    Four self-describing choices and nothing else. No preset code-names, no
    hidden panel, no toggle, no prose.

    Everything explanatory was deliberately removed. The "for a document sent
    today the first reminder would be..." line in particular was misleading: the
    real date depends on when each document was sent, so a single hypothetical
    date invited people to expect the wrong thing. The h2 above already says what
    this section is.

    Anything more specific than these four options is set per document through
    the MCP tool, which is also the only place a per-document deadline can be
    supplied — a deadline cannot be an account-wide default.

    NO JAVASCRIPT IS ADDED. <submit-form data-on="change"> is DocuSeal's own
    element, used by the toggle at the top of this page.

    ONLY USE CLASSES DOCUSEAL ALREADY USES — see the note in _reminder_banner.
    CHECK ON EVERY DOCUSEAL VERSION BUMP.
%>
<%
  default = AccountConfig.find_by(account: current_account, key: IcodosReminders::ACCOUNT_DEFAULT_KEY)&.value
  default = nil unless default.is_a?(Hash)
  selected = default ? (default['preset'] || 'custom') : 'off'

  choices = [
    ['off',          'Never remind anyone'],
    ['gentle',       'After 3 days, then after 7 days, then stop'],
    ['standard',     'After 3 days, then after 7 days, then once a day'],
    ['until_signed', 'Once a week, until they sign']
  ]
%>

<%= form_tag icodos_reminders_path, method: :post, autocomplete: 'off' do %>
  <submit-form data-on="change">
    <div class="space-y-2">
      <% choices.each do |value, label| %>
        <label class="label cursor-pointer justify-start gap-3">
          <input type="radio" name="icodos_reminders[preset]" value="<%= value %>"
                 class="radio" <%= 'checked' if selected == value %>>
          <span><%= label %></span>
        </label>
      <% end %>

      <%# Shown only when a schedule was set through the MCP tool that none of the
          four options represents, so the page never displays a selection that is
          not the one in force. %>
      <% if selected == 'custom' %>
        <label class="label cursor-pointer justify-start gap-3">
          <input type="radio" name="icodos_reminders[preset]" value="custom" class="radio" checked>
          <span>A custom schedule set through Claude</span>
        </label>
      <% end %>
    </div>
  </submit-form>
<% end %>
